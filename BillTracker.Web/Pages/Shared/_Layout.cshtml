<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Utility Ledger</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/BillTracker.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <nav class="site-nav" aria-label="Main navigation">
            <a class="wordmark" asp-area="" asp-page="/Index"><span class="brand-mark" aria-hidden="true">UL</span> Utility Ledger</a>
            <div class="nav-links">
                <a asp-area="" asp-page="/Index">Overview</a>
                <a asp-area="" asp-page="/Bills/Index">All bills</a>
            </div>
            <a class="nav-add" asp-area="" asp-page="/Bills/Create"><span aria-hidden="true">+</span> Add bill</a>
        </nav>
    </header>
    <div class="site-shell">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="site-footer">
        <div class="site-shell footer-inner">
            <span>Utility Ledger</span>
            <span>Household utilities, in clearer view.</span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
